<button
  data-theme-toggle
  class="group relative overflow-hidden border border-white/10 bg-[rgba(139,26,26,0.04)] px-4 py-2 font-mono text-[9px] uppercase tracking-[0.22em] text-[var(--white-muted)] transition-all duration-300 hover:border-[rgba(139,26,26,0.45)] hover:bg-[rgba(139,26,26,0.12)] hover:text-[var(--white)]"
>
  <!-- glow -->
  <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,rgba(139,26,26,0.18),transparent_70%)] opacity-0 transition duration-500 group-hover:opacity-100"></div>

  <!-- content -->
  <span class="relative z-10 flex items-center gap-2">

    <span data-theme-icon>
      ☾
    </span>

    <span data-theme-label>
      Dark
    </span>

  </span>
</button>