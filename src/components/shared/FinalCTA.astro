      HABLEMOS
    </div>
  </div>

  <div class="mx-auto max-w-[1480px] px-8">
    <!-- HEADER -->
    <div class="mb-14 flex items-end gap-5">
      <span
        class="font-mono text-[14px] font-semibold uppercase tracking-[0.32em] text-[rgba(139,26,26,0.95)]"
      >
        // 07
      </span>

      <h2
        data-reveal-title
        class="font-display text-[clamp(44px,6vw,82px)] leading-none tracking-[0.04em]"
