<!-- CONTACT CTA -->
<section
  class="relative overflow-hidden border-b border-[var(--rule)] py-24"
  id="contact"
>
  <!-- Background -->
  <div class="pointer-events-none absolute inset-0 overflow-hidden">
    <div
      class="absolute bottom-[-180px] left-[-120px] h-[520px] w-[520px] rounded-full bg-[rgba(139,26,26,0.08)] blur-[160px]"
