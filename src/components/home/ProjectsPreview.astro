---
import projects from "../../data/projects.json";

const featuredProject = projects.find((project) => project.featured);

const featured = projects[0];
const secondary = projects.slice(1, 3);
---

<section class="relative overflow-hidden bg-[var(--bg)] px-6 py-24 lg:px-8">
  <!-- Glow -->
  <div class="pointer-events-none absolute inset-0 overflow-hidden">
    <div
      class="absolute right-[-220px] top-[-120px] h-[520px] w-[520px] rounded-full bg-[rgba(139,26,26,0.08)] blur-[140px]"
    >
    </div>
  </div>

  <!-- Header -->
  <div class="relative z-10 mb-14 flex items-end gap-5">
    <span class="editorial-kicker"> // 02 </span>

    <h2
      class="font-display text-[clamp(58px,7vw,96px)] leading-none tracking-[0.03em] text-[var(--white)]"
    >
      PROYECTOS
    </h2>

    <div class="mb-3 h-px flex-1 bg-[var(--rule)]"></div>
  </div>

  <!-- Layout -->
  <div class="relative z-10 grid gap-[1px] bg-[var(--rule)]">
    <!-- Featured -->
    {
      featured && (
        <article class="group grid gap-[1px] bg-[var(--rule)] lg:grid-cols-[1.05fr_0.95fr]">
          {/* Left */}
          <div class="relative overflow-hidden bg-[var(--bg2)] p-10 lg:p-14">
            {/* hover top line */}
            <div class="absolute left-0 top-0 h-px w-full bg-gradient-to-r from-transparent via-[rgba(139,26,26,0.5)] to-transparent opacity-0 transition duration-500 group-hover:opacity-100" />

            {/* diagonal */}
            <div class="pointer-events-none absolute inset-0 opacity-20">
              <svg
                class="h-full w-full"
                viewBox="0 0 1000 700"
                preserveAspectRatio="none"
              >
                <line
                  x1="0"
                  y1="700"
                  x2="1000"
                  y2="0"
                  stroke="rgba(139,26,26,0.08)"
                  stroke-width="1"
                />
              </svg>
            </div>

            <div class="relative z-10">
              <div class="mb-8 flex items-center justify-between">
                <span class="editorial-kicker">01 · Destacado</span>

                <span class="editorial-meta">{featured.year}</span>
              </div>

              <h3 class="mb-8 max-w-[560px] font-serif text-[clamp(42px,4vw,72px)] leading-[0.98] tracking-[-0.04em] text-[var(--white)]">
                {featured.title}
              </h3>

              <p class="mb-10 max-w-[560px] text-[17px] leading-[2] text-[var(--white-muted)]">
                {featured.description}
              </p>

              {/* Stack */}
              <div class="mb-10 flex flex-wrap items-center gap-3">
                {featured.stack?.map((tech, index) => (
                  <>
                    <span class="font-mono text-[10px] uppercase tracking-[0.22em] text-[var(--white-muted)]">
                      {tech}
                    </span>

                    {index !== featured.stack.length - 1 && (
                      <span class="text-[rgba(139,26,26,0.5)]">·</span>
                    )}
                  </>
                ))}
              </div>

              <a
                href={
                  featuredProject
                    ? `/projects/${featuredProject.id}`
                    : "/projects"
                }
                class="editorial-button"
              >
                <span>Ver proyecto</span>

                <i class="fa-solid fa-arrow-right" />
              </a>
            </div>
          </div>

          {/* Right Preview */}
          <div class="bg-[var(--bg2)] p-6 lg:p-10">
            <div class="overflow-hidden border border-[var(--rule)] bg-[var(--bg)]">
              {/* Browser Header */}
              <div class="flex items-center gap-2 border-b border-[var(--rule)] px-5 py-4">
                <span class="h-2.5 w-2.5 rounded-full bg-[rgba(139,26,26,0.8)]" />

                <span class="h-2.5 w-2.5 rounded-full bg-[rgba(255,255,255,0.18)]" />

                <span class="h-2.5 w-2.5 rounded-full bg-[rgba(255,255,255,0.18)]" />

                <div class="ml-4 font-mono text-[10px] uppercase tracking-[0.22em] text-[var(--white-dim)]">
                  Vista previa
                </div>
              </div>

              {/* Screenshot */}
              <img
                src={featured.cover}
                alt={featured.title}
                class="w-full transition-transform duration-700 group-hover:scale-[1.015]"
              />
            </div>
          </div>
        </article>
      )
    }

    <!-- Bottom -->
    {
      secondary.length > 0 && (
        <div class="grid gap-[1px] bg-[var(--rule)] lg:grid-cols-2">
          {secondary.map((project, index) => (
            <article class="group relative overflow-hidden bg-[var(--bg2)] p-10 transition-all duration-500 hover:bg-[rgba(139,26,26,0.04)]">
              <div class="absolute left-0 top-0 h-px w-full bg-gradient-to-r from-transparent via-[rgba(139,26,26,0.45)] to-transparent opacity-0 transition duration-500 group-hover:opacity-100" />

              <div class="relative z-10">
                <div class="mb-8 flex items-center justify-between">
                  <span class="editorial-kicker">0{index + 2}</span>

                  <span class="editorial-meta text-[10px]">{project.year}</span>
                </div>

                <h3 class="mb-6 max-w-[420px] font-serif text-[clamp(32px,3vw,52px)] leading-[1.02] tracking-[-0.03em] text-[var(--white)]">
                  {project.title}
                </h3>

                <p class="mb-8 max-w-[500px] text-[16px] leading-[1.95] text-[var(--white-muted)]">
                  {project.description}
                </p>

                {/* Stack */}
                <div class="mb-10 flex flex-wrap items-center gap-3">
                  {project.stack?.map((tech, techIndex) => (
                    <>
                      <span class="font-mono text-[10px] uppercase tracking-[0.22em] text-[var(--white-muted)]">
                        {tech}
                      </span>

                      {techIndex !== project.stack.length - 1 && (
                        <span class="text-[rgba(139,26,26,0.5)]">·</span>
                      )}
                    </>
                  ))}
                </div>

                {/* Button */}
                <a href="#" class="editorial-button">
                  <span>Ver proyecto</span>

                  <i class="fa-solid fa-arrow-right" />
                </a>
              </div>
            </article>
          ))}
        </div>
      )
    }
  </div>
</section>
