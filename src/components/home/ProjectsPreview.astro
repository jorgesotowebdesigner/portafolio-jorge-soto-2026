<section class="relative overflow-hidden bg-[var(--bg)] px-6 py-24 lg:px-8">
  <!-- Glow -->
  <div class="pointer-events-none absolute inset-0 overflow-hidden">
    <div
      class="absolute right-[-220px] top-[-120px] h-[520px] w-[520px] rounded-full bg-[rgba(139,26,26,0.08)] blur-[140px]"
    >
    </div>
  </div>

  <!-- Header -->
  <div class="relative z-10 mb-14 flex items-end gap-5">
    <span class="editorial-kicker"> // 02 </span>

    <h2
      class="font-display text-[clamp(58px,7vw,96px)] leading-none tracking-[0.03em] text-[var(--white)]"
    >
      PROYECTOS
    </h2>

    <div class="mb-3 h-px flex-1 bg-[var(--rule)]"></div>
  </div>

  <!-- Layout -->
  <div class="relative z-10 grid gap-[1px] bg-[var(--rule)]">

    <!-- Featured -->
    <article
      class="group grid gap-[1px] bg-[var(--rule)] lg:grid-cols-[1.05fr_0.95fr]"
    >

      <!-- Left -->
      <div class="relative overflow-hidden bg-[var(--bg2)] p-10 lg:p-14">

        <!-- hover top line -->
        <div
          class="absolute left-0 top-0 h-px w-full bg-gradient-to-r from-transparent via-[rgba(139,26,26,0.5)] to-transparent opacity-0 transition duration-500 group-hover:opacity-100"
        >
        </div>

        <!-- diagonal -->
        <div class="pointer-events-none absolute inset-0 opacity-20">
          <svg
            class="h-full w-full"
            viewBox="0 0 1000 700"
            preserveAspectRatio="none"
          >
            <line
              x1="0"
              y1="700"
              x2="1000"
              y2="0"
              stroke="rgba(139,26,26,0.08)"
              stroke-width="1"
            ></line>
          </svg>
        </div>

        <div class="relative z-10">

          <div class="mb-8 flex items-center justify-between">

            <span class="editorial-kicker">
              01 · Destacado
            </span>

            <span class="editorial-meta">
              2024
            </span>

          </div>

          <h3
            class="mb-8 max-w-[560px] font-serif text-[clamp(42px,4vw,72px)] leading-[0.98] tracking-[-0.04em] text-[var(--white)]"
          >
            Sistema de Diseño
            <br />
            para SaaS B2B
          </h3>

          <p
            class="mb-10 max-w-[560px] text-[17px] leading-[2] text-[var(--white-muted)]"
          >
            Diseño y desarrollo de un sistema de componentes escalable desde
            cero. Incluye tokens de diseño, documentación y librería de React
            con más de 40 componentes.
          </p>

          <!-- Stack -->
          <div class="mb-10 flex flex-wrap items-center gap-3">

            <span class="editorial-meta text-[10px]">
              React
            </span>

            <span class="text-[rgba(139,26,26,0.45)]">·</span>

            <span class="editorial-meta text-[10px]">
              Storybook
            </span>

            <span class="text-[rgba(139,26,26,0.45)]">·</span>

            <span class="editorial-meta text-[10px]">
              Figma
            </span>

            <span class="text-[rgba(139,26,26,0.45)]">·</span>

            <span class="editorial-meta text-[10px]">
              Design Tokens
            </span>

          </div>

          <!-- Button -->
          <a
            href="/projects/sistema-diseno"
            class="hero-button editorial-button"
          >
            Ver proyecto →
          </a>

        </div>
      </div>

      <!-- Right Preview -->
      <div
        class="relative flex items-center justify-center overflow-hidden bg-[var(--bg2)] p-10 lg:p-14"
      >

        <!-- glow -->
        <div
          class="absolute h-[320px] w-[320px] rounded-full bg-[rgba(139,26,26,0.12)] blur-[120px]"
        >
        </div>

        <!-- Preview -->
        <div
          class="editorial-panel relative aspect-[16/10] w-full max-w-[520px] overflow-hidden border border-[rgba(139,26,26,0.14)] bg-[rgba(139,26,26,0.05)]"
        >

          <!-- top bar -->
          <div
            class="absolute left-0 right-0 top-0 z-20 flex h-10 items-center gap-2 border-b border-[var(--rule)] bg-[rgba(0,0,0,0.45)] px-5 backdrop-blur-md"
          >

            <div class="h-2 w-2 rounded-full bg-[rgba(139,26,26,0.6)]"></div>

            <div class="h-2 w-2 rounded-full bg-[var(--rule)]"></div>

            <div class="h-2 w-2 rounded-full bg-[var(--rule)]"></div>

          </div>

          <!-- Image -->
          <img
            src="/preview-muestra.png"
            alt="Preview proyecto"
            class="h-full w-full object-cover transition duration-700 group-hover:scale-[1.02]"
          />

          <!-- Overlay -->
          <div
            class="absolute inset-0 bg-gradient-to-t from-black/30 via-transparent to-black/10"
          >
          </div>

        </div>
      </div>
    </article>

    <!-- Bottom -->
    <div class="grid gap-[1px] bg-[var(--rule)] lg:grid-cols-2">

      <!-- Card 02 -->
      <article
        class="group relative overflow-hidden bg-[var(--bg2)] p-10 transition-all duration-500 hover:bg-[rgba(139,26,26,0.04)]"
      >

        <div
          class="absolute left-0 top-0 h-px w-full bg-gradient-to-r from-transparent via-[rgba(139,26,26,0.45)] to-transparent opacity-0 transition duration-500 group-hover:opacity-100"
        >
        </div>

        <div class="relative z-10">

          <div class="mb-8 flex items-center justify-between">

            <span class="editorial-kicker">
              02
            </span>

            <span class="editorial-meta text-[10px]">
              2024
            </span>

          </div>

          <h3
            class="mb-6 max-w-[420px] font-serif text-[clamp(32px,3vw,52px)] leading-[1.02] tracking-[-0.03em] text-[var(--white)]"
          >
            Landing Page Editorial para Estudio Arquitectónico
          </h3>

          <p
            class="mb-8 max-w-[500px] text-[16px] leading-[1.95] text-[var(--white-muted)]"
          >
            Sitio de lanzamiento con animaciones de scroll, tipografía display y
            rendimiento 100 en Lighthouse.
          </p>

          <!-- Stack -->
          <div class="mb-10 flex flex-wrap items-center gap-3">

            <span class="editorial-meta text-[10px]">
              Astro
            </span>

            <span class="text-[rgba(139,26,26,0.45)]">·</span>

            <span class="editorial-meta text-[10px]">
              GSAP
            </span>

            <span class="text-[rgba(139,26,26,0.45)]">·</span>

            <span class="editorial-meta text-[10px]">
              Tailwind
            </span>

          </div>

          <!-- Button -->
          <a
            href="/projects/landing-editorial"
            class="hero-button editorial-button"
          >
            Ver proyecto →
          </a>

        </div>
      </article>

      <!-- Card 03 -->
      <article
        class="group relative overflow-hidden bg-[var(--bg2)] p-10 transition-all duration-500 hover:bg-[rgba(139,26,26,0.04)]"
      >

        <div
          class="absolute left-0 top-0 h-px w-full bg-gradient-to-r from-transparent via-[rgba(139,26,26,0.45)] to-transparent opacity-0 transition duration-500 group-hover:opacity-100"
        >
        </div>

        <div class="relative z-10">

          <div class="mb-8 flex items-center justify-between">

            <span class="editorial-kicker">
              03
            </span>

            <span class="editorial-meta text-[10px]">
              2024
            </span>

          </div>

          <h3
            class="mb-6 max-w-[420px] font-serif text-[clamp(32px,3vw,52px)] leading-[1.02] tracking-[-0.03em] text-[var(--white)]"
          >
            Dashboard de Analytics
          </h3>

          <p
            class="mb-8 max-w-[500px] text-[16px] leading-[1.95] text-[var(--white-muted)]"
          >
            Interfaz de datos en tiempo real con gráficos interactivos, filtros
            y exportación. Dark mode nativo.
          </p>

          <!-- Stack -->
          <div class="mb-10 flex flex-wrap items-center gap-3">

            <span class="editorial-meta text-[10px]">
              React
            </span>

            <span class="text-[rgba(139,26,26,0.45)]">·</span>

            <span class="editorial-meta text-[10px]">
              Recharts
            </span>

            <span class="text-[rgba(139,26,26,0.45)]">·</span>

            <span class="editorial-meta text-[10px]">
              Zustand
            </span>

          </div>

          <!-- Button -->
          <a
            href="/projects/dashboard-analytics"
            class="hero-button editorial-button"
          >
            Ver proyecto →
          </a>

        </div>
      </article>

    </div>
  </div>
</section>