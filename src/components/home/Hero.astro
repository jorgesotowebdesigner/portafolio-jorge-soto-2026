<section
  data-reveal
  data-reveal-delay="1"
  class="relative w-full min-h-[calc(100vh/1.12)] overflow-hidden bg-[var(--bg)] text-[var(--text)]"
>
  <!-- Glow -->
  <div class="hero-glow"></div>

  <!-- Huge Background Text -->
  <div
    class="hero-bg-word pointer-events-none absolute right-[-10vw] top-[2vw] select-none font-display text-[42vw] leading-none tracking-[0.04em] text-[rgba(139,26,26,0.08)] lg:right-[-1vw] lg:top-[-1vw] lg:text-[min(320px,30vw)]"
  >
    SOTO
  </div>

  <!-- Speed Lines -->
  <div class="speed-lines">
    <svg viewBox="0 0 1200 720" preserveAspectRatio="none">
      <line class="speed-line speed-line-1" x1="0" y1="620" x2="1200" y2="40"
      ></line>

      <line class="speed-line speed-line-2" x1="0" y1="720" x2="1200" y2="180"
      ></line>

      <line class="speed-line speed-line-3" x1="0" y1="520" x2="900" y2="0"
      ></line>
    </svg>
  </div>

  <!-- Top Label -->
  <div class="absolute left-6 top-5 z-10 editorial-kicker">// 01 · PORTADA</div>

  <!-- Divider -->
  <div class="hero-divider"></div>

  <!-- Layout -->
  <div
    class="relative z-[5] grid h-full grid-cols-1 pt-4 lg:grid-cols-[21%_79%]"
  >
    <!-- LEFT -->
    <div
      class="flex flex-col gap-10 border-b border-[var(--rule)] px-6 py-12 lg:justify-between lg:border-b-0 lg:border-r lg:px-8 lg:py-12"
    >
      <!-- Logo -->
      <div
        class="hero-logo relative h-20 w-20 cursor-pointer lg:h-24 lg:w-24"
        data-reveal
        data-reveal-delay="2"
      >
        <div
          class="hero-logo-shadow editorial-panel absolute inset-[4px_-4px_-4px_4px] z-[1] bg-[rgba(139,26,26,0.28)]"
        >
        </div>

        <div
          class="hero-logo-main editorial-panel relative z-[2] flex h-20 w-20 items-center justify-center border border-[rgba(139,26,26,0.5)] bg-[rgba(139,26,26,0.16)] font-serif text-4xl font-bold text-[var(--white)] lg:h-24 lg:w-24"
        >
          JS
        </div>
      </div>

      <!-- Name -->
      <div>
        <div
          class="mb-5 flex items-center gap-3 font-mono text-[13px] font-semibold uppercase tracking-[0.42em] text-[rgba(139,26,26,1)]"
        >
          <div class="editorial-kicker" data-reveal data-reveal-delay="3"></div>

          Diseñador · Dev
        </div>

        <div class="leading-[0.8]">
          <span
            class="block font-display text-[clamp(56px,16vw,120px)] tracking-[-0.05em] text-[var(--white)]"
          >
            JORGE
          </span>

          <span
            class="block font-display text-[clamp(56px,16vw,120px)] tracking-[-0.05em] text-[var(--white-dim)]"
          >
            SOTO
          </span>
        </div>

        <div
          class="mt-8 flex items-center gap-3 font-mono text-[11px] uppercase tracking-[0.22em] text-[var(--white-muted)]"
        >
          <div class="status-dot h-[7px] w-[7px] rounded-full bg-[#5a9d5a]">
          </div>

          Disponible para proyectos
        </div>
      </div>
    </div>

    <!-- RIGHT -->
    <div class="flex h-full flex-col px-6 py-8 lg:px-14 lg:py-10">
      <div>
        <!-- Roles -->
        <div class="mb-6 flex flex-wrap items-center gap-x-4 gap-y-2">
          <span class="editorial-kicker"> Frontend Developer </span>

          <span class="font-mono text-[11px] text-[var(--white-dim)]"> / </span>

          <span
            class="font-mono text-[13px] font-semibold uppercase tracking-[0.42em] text-[var(--white-muted)]"
          >
            UX/UI Designer
          </span>
        </div>

        <!-- Main Title -->
        <h1
          data-reveal-title
          class="max-w-[1180px] font-serif text-[clamp(54px,14vw,128px)] leading-[0.92] tracking-[-0.055em] text-[var(--white)] lg:text-[clamp(72px,5.9vw,128px)] lg:leading-[0.9]"
        >
          Diseño y desarrollo interfaces digitales

          <em
            class="mt-4 block italic leading-[0.92] text-[var(--white-muted)]"
          >
            con enfoque UI y frontend moderno.
          </em>
        </h1>

        <!-- Description -->
        <p
          class="mt-6 max-w-[560px] text-[15px] leading-[1.9] text-[var(--white-muted)] lg:mt-5 lg:max-w-[720px] lg:text-[16px]"
        >
          Construyo experiencias web utilizando Astro, React, Tailwind,
          WordPress y Shopify, mezclando diseño visual, sistemas UI y desarrollo
          frontend.
        </p>

        <!-- Divider -->
        <div class="mt-10 flex items-center gap-4">
          <div class="h-px flex-1 bg-[var(--rule)]"></div>

          <span
            class="font-mono text-[10px] tracking-[0.24em] text-[var(--white-dim)]"
          >
            2026
          </span>
        </div>
      </div>

      <!-- Bottom -->
      <div class="mt-8 flex flex-col gap-6">
        <div class="flex items-center gap-3">
          <span class="h-px w-6 bg-[rgba(139,26,26,0.45)]"></span>

          <span
            class="font-mono text-[11px] font-semibold uppercase tracking-[0.32em] text-[var(--white)]"
          >
            +4 años experiencia
          </span>
        </div>

        <div
          class="flex flex-wrap items-center gap-x-6 gap-y-2 font-mono text-[11px] uppercase tracking-[0.28em] text-[var(--white-dim)]"
        >
          <span>Astro</span>

          <span class="opacity-80">•</span>

          <span>React</span>

          <span class="opacity-80">•</span>

          <span>Tailwind</span>

          <span class="opacity-80">•</span>

          <span>WordPress</span>

          <span class="opacity-80">•</span>

          <span>Shopify</span>
        </div>
      </div>

      <!-- Actions -->
      <div
        class="mt-10 flex flex-col items-start gap-4 pb-2 lg:mt-0 lg:items-end lg:pb-6 lg:pr-6"
      >
        <a href="#" class="editorial-button">
          <span>Ver proyectos</span>

          <i class="fa-solid fa-arrow-right"></i>
        </a>

        <a
          href="https://github.com/jorgesotowebdesigner"
          target="_blank"
          class="group inline-flex items-center gap-3 font-mono text-[11px] uppercase tracking-[0.28em] text-[var(--white-muted)] transition-colors duration-300 hover:text-[var(--white)]"
        >
          <span>GitHub</span>

          <i
            class="fa-brands fa-github text-[15px] text-[rgba(139,26,26,0.82)] transition-transform duration-300 group-hover:translate-x-[2px]"
          ></i>
        </a>
      </div>
    </div>
  </div>
</section>

<!-- Bottom Line -->
<div class="hero-bottom-line"></div>
