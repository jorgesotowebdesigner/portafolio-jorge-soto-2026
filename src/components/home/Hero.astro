<section
  class="relative w-full min-h-[calc(100vh/1.12)] overflow-hidden bg-[var(--bg)] text-[var(--text)]"
>
  <!-- Glow -->
  <div class="hero-glow"></div>

  <!-- Huge Background Text -->
  <div
    class="pointer-events-none absolute right-[-1vw] top-[-1vw] select-none font-display text-[min(320px,30vw)] leading-none tracking-[0.04em] text-[rgba(139,26,26,0.08)]"
  >
    SOTO
  </div>

  <!-- Speed Lines -->
  <div class="speed-lines">
    <svg viewBox="0 0 1200 720" preserveAspectRatio="xMidYMid slice">
      <line
        x1="0"
        y1="620"
        x2="1200"
        y2="40"
        stroke="rgba(139,26,26,0.08)"
        stroke-width="1"></line>

      <line
        x1="0"
        y1="720"
        x2="1200"
        y2="180"
        stroke="rgba(255,255,255,0.03)"
        stroke-width="0.5"></line>

      <line
        x1="0"
        y1="520"
        x2="900"
        y2="0"
        stroke="rgba(139,26,26,0.06)"
        stroke-width="0.5"></line>
    </svg>
  </div>

  <!-- Top Label -->
  <div
    class="absolute left-6 top-7 z-10 font-mono text-[10px] uppercase tracking-[0.35em] text-[rgba(139,26,26,0.78)]"
  >
    // 01 · PORTADA
  </div>

  <!-- Divider -->
  <div class="hero-divider"></div>

  <!-- Layout -->
  <div class="relative z-[5] grid h-full grid-cols-[21%_79%] pt-4">
    <!-- Left -->
    <div
      class="flex flex-col justify-between border-r border-[var(--rule)] px-8 py-12"
    >
      <!-- Logo -->
      <div class="relative h-24 w-24 cursor-pointer">
        <div
          class="editorial-panel absolute inset-[4px_-4px_-4px_4px] z-[1] bg-[rgba(139,26,26,0.28)]"
        >
        </div>

        <div
          class="editorial-panel relative z-[2] flex h-24 w-24 items-center justify-center border border-[rgba(139,26,26,0.5)] bg-[rgba(139,26,26,0.16)] font-serif text-4xl font-bold text-[var(--white)]"
        >
          JS
        </div>
      </div>

      <!-- Name -->
      <div>
        <div
          class="mb-5 flex items-center gap-3 font-mono text-[11px] uppercase tracking-[0.34em] text-[rgba(139,26,26,0.82)]"
        >
          <div class="h-px w-6 bg-[rgba(139,26,26,0.5)]"></div>

          Diseñador · Dev
        </div>

        <div class="leading-[0.8]">
          <span
            class="block font-display text-[clamp(72px,7vw,120px)] tracking-[-0.05em] text-[var(--white)]"
          >
            JORGE
          </span>

          <span
            class="block font-display text-[clamp(72px,7vw,120px)] tracking-[-0.05em] text-[var(--white-dim)]"
          >
            SOTO
          </span>
        </div>

        <div
          class="mt-8 flex items-center gap-3 font-mono text-[11px] uppercase tracking-[0.22em] text-[var(--white-muted)]"
        >
          <div class="h-[7px] w-[7px] rounded-full bg-[#5a9d5a]"></div>

          Disponible para proyectos
        </div>
      </div>
    </div>

    <!-- Right -->
    <div class="flex h-full flex-col px-14 py-10">
      <div>
        <!-- Roles -->
        <div class="mb-6 flex items-center gap-4">
          <span
            class="font-mono text-[11px] uppercase tracking-[0.28em] text-[rgba(139,26,26,0.9)]"
          >
            Frontend Developer
          </span>

          <span class="font-mono text-[11px] text-[var(--white-dim)]"> / </span>

          <span
            class="font-mono text-[11px] uppercase tracking-[0.28em] text-[var(--white-muted)]"
          >
            UX/UI Designer
          </span>
        </div>

        <!-- Main Title -->
        <h1
          class="max-w-[1180px] font-serif text-[clamp(78px,6.3vw,136px)] leading-[0.9] tracking-[-0.055em] text-[var(--white)]"
        >
          Diseño y desarrollo interfaces digitales

          <em class="mt-2 block italic text-[var(--white-muted)]">
            con enfoque UI y frontend moderno.
          </em>
        </h1>

        <!-- Description -->
        <p
          class="mt-5 max-w-[720px] text-[16px] leading-[1.75] text-[var(--white-muted)]"
        >
          Construyo experiencias web utilizando Astro, React, Tailwind,
          WordPress y Shopify, mezclando diseño visual, sistemas UI y desarrollo
          frontend.
        </p>

        <!-- Divider -->
        <div class="mt-10 flex items-center gap-4">
          <div class="h-px flex-1 bg-[var(--rule)]"></div>

          <span
            class="font-mono text-[10px] tracking-[0.24em] text-[var(--white-dim)]"
          >
            2026
          </span>
        </div>
      </div>

      <!-- Bottom -->
      <div class="mt-8 flex flex-col gap-6">
        <div class="flex items-center gap-3">
          <span class="h-px w-6 bg-[rgba(139,26,26,0.45)]"></span>

          <span
            class="font-mono text-[11px] uppercase tracking-[0.32em] text-[var(--white)]"
          >
            +4 años experiencia
          </span>
        </div>

        <div
          class="flex flex-wrap items-center gap-x-6 gap-y-2 font-mono text-[11px] uppercase tracking-[0.28em] text-[var(--white-dim)]"
        >
          <span class="text-[rgba(139,26,26,0.9)]">Astro</span>

          <span class="opacity-30">•</span>

          <span>React</span>

          <span class="opacity-30">•</span>

          <span>Tailwind</span>

          <span class="opacity-30">•</span>

          <span>WordPress</span>

          <span class="opacity-30">•</span>

          <span>Shopify</span>
        </div>
      </div>

      <!-- Actions -->
      <div class="flex flex-col items-end gap-4 pb-6 pr-6">
        <a href="#proyectos" class="editorial-button"> Ver proyectos </a>
        <a
          href="https://github.com/jorgesotowebdesigner"
          target="_blank"
          class="hero-github"
        >
          GitHub →
        </a>
      </div>
    </div>
  </div>
</section>

<!-- Bottom Line -->
<div class="hero-bottom-line"></div>
