          <div class="flex items-center gap-5">
            <i
              class="fa-regular fa-envelope text-[18px] text-[rgba(139,26,26,0.8)] transition-all duration-300 group-hover:scale-110 group-hover:text-[rgba(139,26,26,1)]"
