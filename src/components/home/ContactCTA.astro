              EMAIL
            </span>
          </div>

          <div class="flex items-center gap-5">
            <span
              class="font-serif text-[clamp(18px,1.45vw,30px)] leading-[1.08] tracking-[-0.02em] text-[var(--white)]"
            >
              jorgesoto.webdesigner
            </span>

            <span
              class="font-mono text-[12px] text-[rgba(139,26,26,0.8)] transition-transform duration-300 group-hover:translate-x-1"
            >
              →
            </span>
          </div>
        </a>

        <!-- LinkedIn -->
        <a
