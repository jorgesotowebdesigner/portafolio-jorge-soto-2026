<section
  id="contact"
  class="relative overflow-hidden bg-[var(--bg)] px-6 py-10 lg:px-10"
>
  <!-- Background -->
  <div class="pointer-events-none absolute inset-0 overflow-hidden">
    <div
      class="absolute bottom-[-180px] left-[-120px] h-[520px] w-[520px] rounded-full bg-[rgba(139,26,26,0.08)] blur-[160px]"
