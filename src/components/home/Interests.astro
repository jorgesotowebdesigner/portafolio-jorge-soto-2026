<section class="relative overflow-hidden bg-[var(--bg2)] px-6 py-20 lg:px-8">
  <!-- Glow -->
  <div class="pointer-events-none absolute inset-0 overflow-hidden">
    <div
      class="absolute left-[-120px] top-[30%] h-[420px] w-[420px] rounded-full bg-[rgba(139,26,26,0.05)] blur-[140px]"
    >
    </div>

    <div
      class="absolute bottom-0 left-0 h-px w-full bg-gradient-to-r from-transparent via-[var(--rule)] to-transparent"
    >
    </div>
  </div>

  <!-- Header -->
  <div class="relative z-10 mb-16 flex items-end gap-5">
    <span class="editorial-kicker"> // 04 </span>

    <h2
      data-reveal-title
      class="font-display text-[42px] leading-none tracking-[0.05em] text-[var(--text)]"
    >
      INTERESES
    </h2>

    <div
      data-reveal-divider
      class="project-divider mb-3 h-px flex-1 bg-[rgba(255,255,255,0.18)]"
    >
    </div>
  </div>

  <!-- Grid -->
  <div class="relative z-10 grid gap-[1px] bg-[var(--rule)] lg:grid-cols-3">
    <!-- CARD -->
    <article
      class="group relative overflow-hidden bg-[var(--bg3)] p-8 transition-all duration-500 hover:bg-[rgba(139,26,26,0.03)]"
    >
      <div
        class="pointer-events-none absolute bottom-[-25px] right-2 font-display text-[120px] leading-none text-[rgba(139,26,26,0.10)]"
      >
        01
      </div>

      <div class="relative z-10">
        <span class="editorial-kicker mb-5 inline-block">
          CINE & SUPERHÉROES
        </span>

        <h3
          data-reveal-title
          class="mb-5 font-serif text-[34px] leading-[1.02] tracking-[-0.02em] text-[var(--text)]"
        >
          Narrativa Visual
        </h3>

        <p
          class="max-w-[340px] text-[15px] font-light leading-[1.95] text-[var(--text-muted)]"
        >
          Películas de acción, aventura y universos cinematográficos como
          Marvel. Inspiración en dirección visual, ritmo narrativo y estética
          épica.
        </p>
      </div>
    </article>

    <!-- CARD -->
    <article
      class="group relative overflow-hidden bg-[var(--bg3)] p-8 transition-all duration-500 hover:bg-[rgba(139,26,26,0.03)]"
    >
      <div
        class="pointer-events-none absolute bottom-[-25px] right-2 font-display text-[120px] leading-none text-[rgba(139,26,26,0.10)]"
      >
        02
      </div>

      <div class="relative z-10">
        <span class="editorial-kicker mb-5 inline-block">
          DEPORTES & MOVIMIENTO
        </span>

        <h3
          data-reveal-title
          class="mb-5 font-serif text-[34px] leading-[1.02] tracking-[-0.02em] text-[var(--text)]"
        >
          Vida Activa
        </h3>

        <p
          class="max-w-[340px] text-[15px] font-light leading-[1.95] text-[var(--text-muted)]"
        >
          Fútbol, surf, running y entrenamiento. Interés por la disciplina, la
          energía y el equilibrio entre mente y cuerpo.
        </p>
      </div>
    </article>

    <!-- CARD -->
    <article
      class="group relative overflow-hidden bg-[var(--bg3)] p-8 transition-all duration-500 hover:bg-[rgba(139,26,26,0.03)]"
    >
      <div
        class="pointer-events-none absolute bottom-[-25px] right-2 font-display text-[120px] leading-none text-[rgba(139,26,26,0.10)]"
      >
        03
      </div>

      <div class="relative z-10">
        <span class="editorial-kicker mb-5 inline-block"> MÚSICA </span>

        <h3
          data-reveal-title
          class="mb-5 font-serif text-[34px] leading-[1.02] tracking-[-0.02em] text-[var(--text)]"
        >
          Música & Creatividad
        </h3>

        <p
          class="max-w-[340px] text-[15px] font-light leading-[1.95] text-[var(--text-muted)]"
        >
          OGuitarra, canto y aprendizaje constante en piano. La música como
          espacio creativo, expresión emocional y exploración artística.
        </p>
      </div>
    </article>

    <!-- CARD -->
    <article
      class="group relative overflow-hidden bg-[var(--bg3)] p-8 transition-all duration-500 hover:bg-[rgba(139,26,26,0.03)]"
    >
      <div
        class="pointer-events-none absolute bottom-[-25px] right-2 font-display text-[120px] leading-none text-[rgba(139,26,26,0.10)]"
      >
        04
      </div>

      <div class="relative z-10">
        <span class="editorial-kicker mb-5 inline-block">
          GUNDAM & MODELISMO
        </span>

        <h3
          data-reveal-title
          class="mb-5 font-serif text-[34px] leading-[1.02] tracking-[-0.02em] text-[var(--text)]"
        >
          Gunpla & Detalle
        </h3>

        <p
          class="max-w-[340px] text-[15px] font-light leading-[1.95] text-[var(--text-muted)]"
        >
          Construcción de Gundams y fascinación por el diseño mecánico, la
          precisión visual y el proceso manual detrás de cada pieza.
        </p>
      </div>
    </article>

    <!-- CARD -->
    <article
      class="group relative overflow-hidden bg-[var(--bg3)] p-8 transition-all duration-500 hover:bg-[rgba(139,26,26,0.03)]"
    >
      <div
        class="pointer-events-none absolute bottom-[-25px] right-2 font-display text-[120px] leading-none text-[rgba(139,26,26,0.10)]"
      >
        05
      </div>

      <div class="relative z-10">
        <span class="editorial-kicker mb-5 inline-block">
          TECNOLOGÍA & WEB
        </span>

        <h3
          data-reveal-title
          class="mb-5 font-serif text-[34px] leading-[1.02] tracking-[-0.02em] text-[var(--text)]"
        >
          Frontend & Sistemas
        </h3>

        <p
          class="max-w-[340px] text-[15px] font-light leading-[1.95] text-[var(--text-muted)]"
        >
          Aprendizaje continuo sobre desarrollo web, diseño UI, performance,
          nuevas tecnologías y construcción de experiencias digitales.
        </p>
      </div>
    </article>

    <!-- CARD -->
    <article
      class="group relative overflow-hidden bg-[var(--bg3)] p-8 transition-all duration-500 hover:bg-[rgba(139,26,26,0.03)]"
    >
      <div
        class="pointer-events-none absolute bottom-[-25px] right-2 font-display text-[120px] leading-none text-[rgba(139,26,26,0.10)]"
      >
        06
      </div>

      <div class="relative z-10">
        <span class="editorial-kicker mb-5 inline-block">
          ANIMÉ, GAMING & FAMILIA
        </span>

        <h3
          data-reveal-title
          class="mb-5 font-serif text-[34px] leading-[1.02] tracking-[-0.02em] text-[var(--text)]"
        >
          Cultura & Tiempo Personal
        </h3>

        <p
          class="max-w-[340px] text-[15px] font-light leading-[1.95] text-[var(--text-muted)]"
        >
          Videojuegos, animé y momentos en familia. Disfruto tanto los panoramas
          tranquilos como las experiencias divertidas compartidas.
        </p>
      </div>
    </article>
  </div>
</section>
