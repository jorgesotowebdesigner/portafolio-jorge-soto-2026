<section class="relative overflow-hidden bg-[var(--bg)] px-6 py-24 text-[var(--white)] lg:px-10 lg:py-28">

  <!-- Background -->
  <div class="pointer-events-none absolute inset-0 overflow-hidden">

    <!-- glow -->
    <div
      class="absolute bottom-[-140px] right-[-120px] h-[520px] w-[520px] rounded-full bg-[rgba(139,26,26,0.14)] blur-[180px]"
    ></div>

    <!-- giant word -->
    <div
      class="absolute bottom-[-40px] left-[-10px] select-none font-display text-[min(340px,24vw)] leading-none tracking-[0.02em] text-[rgba(139,26,26,0.12)]"
    >
      HABLEMOS
    </div>

  </div>

  <!-- Header -->
  <div class="relative z-10 mb-14 flex items-end gap-5">

    <span
      class="font-mono text-[10px] uppercase tracking-[0.34em] text-[rgba(139,26,26,0.72)]"
    >
      // 08
    </span>

    <h2
      class="font-display text-[clamp(52px,4vw,84px)] leading-none tracking-[0.04em] text-[var(--white)]"
    >
      CONTACTO
    </h2>

    <div class="mb-2 h-px flex-1 bg-[var(--rule)]"></div>

  </div>

  <!-- Content -->
  <div
    class="relative z-10 grid grid-cols-1 items-center gap-16 lg:grid-cols-[1fr_520px]"
  >

    <!-- Left -->
    <div>

      <div
        class="mb-6 font-mono text-[10px] uppercase tracking-[0.34em] text-[rgba(139,26,26,0.68)]"
