<section class="relative overflow-hidden border-b border-[var(--rule)] bg-[var(--bg)] px-6 py-16 text-[var(--white)] lg:px-10 lg:py-20">

  <!-- Background -->
  <div
    class="pointer-events-none absolute left-[-120px] bottom-[-120px] h-[320px] w-[320px] rounded-full bg-[rgba(139,26,26,0.05)] blur-[120px]"
  ></div>

  <!-- Header -->
  <div class="relative z-10 mb-14 flex items-end gap-5">

    <span
      class="font-mono text-[9px] uppercase tracking-[0.32em] text-[rgba(139,26,26,0.65)]"
    >
      // 07
    </span>

    <h2
      class="font-display text-[42px] leading-none tracking-[0.05em] text-[var(--white)]"
    >
      FUERA DEL TRABAJO
    </h2>

    <div class="mb-1 h-px flex-1 bg-[var(--rule)]"></div>

  </div>

  <!-- Layout -->
  <div class="relative z-10 grid grid-cols-1 gap-px bg-[var(--rule)] lg:grid-cols-[42%_58%]">

    <!-- Left -->
    <div class="relative overflow-hidden bg-[var(--bg3)] p-8 lg:p-12">

      <!-- giant number -->
      <div
        class="pointer-events-none absolute bottom-[-40px] right-0 font-display text-[180px] leading-none tracking-[0.02em] text-[rgba(139,26,26,0.06)]"
      >
        08
      </div>

      <div class="relative z-10">

        <div
          class="mb-5 font-mono text-[8px] uppercase tracking-[0.32em] text-[rgba(139,26,26,0.65)]"
        >
          Inspiración
        </div>

        <h3
          class="mb-8 max-w-[420px] font-serif text-[clamp(30px,4vw,48px)] leading-[1.04] tracking-[-0.03em] text-[var(--white)]"
        >

          Todo lo que consumo
          termina influyendo
          en cómo diseño.

        </h3>

        <p
          class="max-w-[520px] text-[15px] font-light leading-[2] tracking-[0.01em] text-[var(--white-muted)]"
        >

          Me inspiran los cómics, el cine, la música,
          el fútbol, el surf y las experiencias digitales
          con personalidad fuerte y narrativa visual.

        </p>

      </div>

    </div>

    <!-- Right -->
    <div class="grid gap-px bg-[var(--rule)]">

      <!-- Item -->
      <article
        class="group relative overflow-hidden bg-[var(--bg3)] px-8 py-7 transition-all duration-500 hover:bg-[rgba(139,26,26,0.04)]"
      >

        <div
          class="absolute left-0 top-0 h-px w-full bg-gradient-to-r from-transparent via-[rgba(139,26,26,0.5)] to-transparent opacity-0 transition duration-500 group-hover:opacity-100"
        ></div>

        <div
          class="mb-3 font-mono text-[8px] uppercase tracking-[0.28em] text-[rgba(139,26,26,0.55)]"
        >
          Comics
        </div>

        <h4
          class="mb-3 font-serif text-[28px] leading-[1.05] text-[var(--white)]"
        >
          Narrativa visual
        </h4>

        <p
          class="max-w-[520px] text-[13px] font-light leading-[1.9] text-[var(--white-muted)]"
        >

          Spiderman, composición editorial y storytelling visual
          aplicado a interfaces digitales.

        </p>

      </article>

      <!-- Item -->
      <article
        class="group relative overflow-hidden bg-[var(--bg3)] px-8 py-7 transition-all duration-500 hover:bg-[rgba(139,26,26,0.04)]"
      >

        <div
          class="absolute left-0 top-0 h-px w-full bg-gradient-to-r from-transparent via-[rgba(139,26,26,0.5)] to-transparent opacity-0 transition duration-500 group-hover:opacity-100"
        ></div>

        <div
          class="mb-3 font-mono text-[8px] uppercase tracking-[0.28em] text-[rgba(139,26,26,0.55)]"
        >
          Cine & Música
        </div>

        <h4
          class="mb-3 font-serif text-[28px] leading-[1.05] text-[var(--white)]"
        >
          Ritmo & atmósfera
        </h4>

        <p
          class="max-w-[520px] text-[13px] font-light leading-[1.9] text-[var(--white-muted)]"
        >

          Uso composición, contraste y timing visual
          inspirados en experiencias cinematográficas.

        </p>

      </article>

      <!-- Item -->
      <article
        class="group relative overflow-hidden bg-[var(--bg3)] px-8 py-7 transition-all duration-500 hover:bg-[rgba(139,26,26,0.04)]"
      >

        <div
          class="absolute left-0 top-0 h-px w-full bg-gradient-to-r from-transparent via-[rgba(139,26,26,0.5)] to-transparent opacity-0 transition duration-500 group-hover:opacity-100"
        ></div>

        <div
          class="mb-3 font-mono text-[8px] uppercase tracking-[0.28em] text-[rgba(139,26,26,0.55)]"
        >
          Deporte
        </div>

        <h4
          class="mb-3 font-serif text-[28px] leading-[1.05] text-[var(--white)]"
        >
          Energía & movimiento
        </h4>

        <p
          class="max-w-[520px] text-[13px] font-light leading-[1.9] text-[var(--white-muted)]"
        >

          El fútbol y el surf influyen en mi forma
          de pensar ritmo, fluidez y equilibrio visual.

        </p>

      </article>

    </div>

  </div>

</section>