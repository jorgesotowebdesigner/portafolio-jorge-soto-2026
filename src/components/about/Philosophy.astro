<section class="relative overflow-hidden border-b border-[var(--rule)] bg-[var(--bg)] px-6 py-16 text-[var(--white)] lg:px-10 lg:py-20">

  <!-- Background -->
  <div
    class="pointer-events-none absolute left-[-120px] top-[20%] h-[320px] w-[320px] rounded-full bg-[rgba(139,26,26,0.06)] blur-[120px]"
  ></div>

  <!-- Header -->
  <div class="relative z-10 mb-14 flex items-end gap-5">

    <span
      class="font-mono text-[9px] uppercase tracking-[0.32em] text-[rgba(139,26,26,0.65)]"
    >
      // 05
    </span>

    <h2
      class="font-display text-[42px] leading-none tracking-[0.05em] text-[var(--white)]"
    >
      CÓMO TRABAJO
    </h2>

    <div class="mb-1 h-px flex-1 bg-[var(--rule)]"></div>

  </div>

  <!-- Grid -->
  <div class="relative z-10 grid grid-cols-1 border border-[var(--rule)] lg:grid-cols-3">

    <!-- Item -->
    <article
      class="group relative overflow-hidden border-b border-[var(--rule)] bg-[var(--bg3)] p-8 transition-all duration-500 hover:bg-[rgba(139,26,26,0.04)] lg:border-b-0 lg:border-r"
    >

      <!-- Hover Glow -->
      <div
        class="absolute inset-0 bg-[radial-gradient(circle_at_top_left,rgba(139,26,26,0.12),transparent_60%)] opacity-0 transition duration-500 group-hover:opacity-100"
      ></div>

      <!-- Number -->
      <div
        class="mb-8 font-display text-[72px] leading-none tracking-[0.03em] text-[rgba(139,26,26,0.08)] transition duration-500 group-hover:text-[rgba(139,26,26,0.14)]"
      >
        01
      </div>

      <!-- Title -->
      <h3
        class="relative z-10 mb-5 max-w-[220px] font-serif text-[28px] leading-[1.1] text-[var(--white)]"
      >
        Forma y función
        <br />
        en lo mismo
      </h3>

      <!-- Text -->
      <p
        class="relative z-10 text-[14px] font-light leading-[1.9] text-[var(--white-muted)]"
      >

        Las interfaces deben verse bien, pero también sentirse rápidas,
        intuitivas y sólidas. El diseño que funciona es invisible.

      </p>

    </article>

    <!-- Item -->
    <article
      class="group relative overflow-hidden border-b border-[var(--rule)] bg-[var(--bg3)] p-8 transition-all duration-500 hover:bg-[rgba(139,26,26,0.04)] lg:border-b-0 lg:border-r"
    >

      <div
        class="absolute inset-0 bg-[radial-gradient(circle_at_top_left,rgba(139,26,26,0.12),transparent_60%)] opacity-0 transition duration-500 group-hover:opacity-100"
      ></div>

      <div
        class="mb-8 font-display text-[72px] leading-none tracking-[0.03em] text-[rgba(139,26,26,0.08)] transition duration-500 group-hover:text-[rgba(139,26,26,0.14)]"
      >
        02
      </div>

      <h3
        class="relative z-10 mb-5 max-w-[220px] font-serif text-[28px] leading-[1.1] text-[var(--white)]"
      >
        El detalle es
        <br />
        invisible
      </h3>

      <p
        class="relative z-10 text-[14px] font-light leading-[1.9] text-[var(--white-muted)]"
      >

        Animaciones suaves, composición consistente y sistemas visuales
        coherentes crean experiencias que se sienten premium sin notarse.

      </p>

    </article>

    <!-- Item -->
    <article
      class="group relative overflow-hidden bg-[var(--bg3)] p-8 transition-all duration-500 hover:bg-[rgba(139,26,26,0.04)]"
    >

      <div
        class="absolute inset-0 bg-[radial-gradient(circle_at_top_left,rgba(139,26,26,0.12),transparent_60%)] opacity-0 transition duration-500 group-hover:opacity-100"
      ></div>

      <div
        class="mb-8 font-display text-[72px] leading-none tracking-[0.03em] text-[rgba(139,26,26,0.08)] transition duration-500 group-hover:text-[rgba(139,26,26,0.14)]"
      >
        03
      </div>

      <h3
        class="relative z-10 mb-5 max-w-[220px] font-serif text-[28px] leading-[1.1] text-[var(--white)]"
      >
        Menos,
        pero mejor
      </h3>

      <p
        class="relative z-10 text-[14px] font-light leading-[1.9] text-[var(--white-muted)]"
      >

        Cada elemento necesita propósito. Prefiero sistemas simples,
        claros y bien ejecutados antes que interfaces saturadas.

      </p>

    </article>

  </div>

</section>