---
import '../styles/global.css';

const { title = 'Jorge Soto' } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>

    <link rel="icon" type="image/png" href="/favicon.png" />
  </head>

  <body class="antialiased">
    <slot />
  </body>
</html>