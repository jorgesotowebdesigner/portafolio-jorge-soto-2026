---
import '../styles/global.css';
import Nav from '../components/ui/Nav.astro';

const { title = 'Jorge Soto' } = Astro.props;
---

<!doctype html>

<html lang="es">

  <head>

    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />

    <title>{title}</title>

    <link
      rel="icon"
      type="image/png"
      href="/favicon.png"
    />

  </head>

  <body class="antialiased">

    <!-- NAVBAR -->
    <Nav />

    <!-- CONTENT -->
    <main class="pt-[0px]">

      <slot />

    </main>

  </body>

</html>