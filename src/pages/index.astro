---
import MainLayout from '../layouts/MainLayout.astro';

import Nav from '../components/ui/Nav.astro';

import Hero from '../components/home/Hero.astro';
import Projects from '../components/home/ProjectsPreview.astro';
import Timeline from '../components/home/Timeline.astro';
import Interests from '../components/home/Interests.astro';
import ContactCTA from '../components/home/ContactCTA.astro';
---

<MainLayout title="Jorge Soto">

  <div class="bg-[var(--bg)] text-[var(--white)] transition-colors duration-500">

    <Nav />

    <main>

      <Hero />

      <Projects />

      <Timeline />

      <Interests />

      <ContactCTA />

    </main>

  </div>

</MainLayout>