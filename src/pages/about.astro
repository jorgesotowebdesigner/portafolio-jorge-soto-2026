---
import MainLayout from "../layouts/MainLayout.astro";
import about from "../data/about.json";
---

<MainLayout title="Sobre mí">
  <main>
    <!-- HERO -->
    <section class="border-b border-[var(--rule)] py-16">
      <div class="mx-auto max-w-[1480px] px-8">
        <div class="flex items-end justify-between">
          <div>
            <div
              class="mb-6 font-mono text-[10px] uppercase tracking-[0.22em] text-[rgba(139,26,26,0.7)]"
            >
              {about.hero.section}
            </div>

            <h1
              class="font-display text-[clamp(64px,9vw,120px)] leading-[0.95]"
            >
              {about.hero.title}
            </h1>

            <p class="mt-5 font-serif italic text-[var(--white-muted)]">
              {about.hero.subtitle}
            </p>
          </div>

          <div class="hidden flex-col items-end lg:flex">
            <!-- LOGO -->
            <div class="relative h-24 w-24">
              <!-- BACK PANEL -->
              <div
                class="editorial-panel absolute inset-[4px_-4px_-4px_4px] z-[1] bg-[rgba(139,26,26,0.28)]"
              >
              </div>

              <!-- FRONT PANEL -->
              <div
                class="editorial-panel relative z-[2] flex h-24 w-24 items-center justify-center border border-[rgba(139,26,26,0.5)] bg-[rgba(139,26,26,0.16)] font-serif text-4xl font-bold text-[var(--white)]"
              >
                JS
              </div>
            </div>

            <!-- META -->
            <div
              class="mt-6 font-mono text-[9px] uppercase tracking-[0.28em] text-[var(--white-dim)]"
            >
              {about.hero.meta}
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- INTRO -->
    <section class="border-b border-[var(--rule)] py-20">
      <div class="mx-auto grid max-w-[1480px] lg:grid-cols-[36%_64%]">
        <!-- LEFT -->
        <div class="border-r border-[var(--rule)] px-8">
          <div class="mb-10">
            <div class="font-display text-[84px] leading-[0.85]">
              {about.intro.name}
            </div>

            <div
              class="font-display text-[84px] leading-[0.78] text-[var(--white-dim)]"
            >
              {about.intro.lastname}
            </div>
          </div>

          <div class="space-y-5">
            <div class="grid grid-cols-[120px_1fr]">
              <span
                class="font-mono text-[11px] uppercase tracking-[0.18em] text-[rgba(139,26,26,0.72)]"
              >
                UBICACIÓN
              </span>

              <span
                class="font-mono text-[11px] uppercase tracking-[0.08em] text-[var(--white-muted)]"
              >
                {about.intro.location}
              </span>
            </div>

            <div class="grid grid-cols-[120px_1fr]">
              <span
                class="font-mono text-[11px] uppercase tracking-[0.18em] text-[rgba(139,26,26,0.72)]"
              >
                Stack
              </span>

              <span
                class="font-mono text-[11px] uppercase tracking-[0.08em] text-[var(--white-muted)]"
              >
                {about.intro.stack}
              </span>
            </div>
          </div>
        </div>

        <!-- RIGHT -->
        <div class="px-10">
          <p
            class="max-w-[780px] font-serif text-[clamp(30px,3vw,44px)] leading-[1.4] tracking-[-0.03em]"
          >
            {about.intro.headline}
          </p>

          <div class="mt-12 space-y-8">
            {
              about.intro.paragraphs.map((item) => (
                <p class="max-w-[720px] text-[17px] leading-[2] text-[var(--white-muted)]">
                  {item}
                </p>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <!-- COMO TRABAJO -->
<section class="border-b border-[var(--rule)] py-24 lg:py-32">

  <div class="mx-auto max-w-[1480px] px-8">

    <!-- HEADER -->
    <div class="mb-20 flex items-end gap-5">

      <span
        class="font-mono text-[9px] uppercase tracking-[0.22em] text-[rgba(139,26,26,0.65)]"
      >
        // 05
      </span>

      <h2
        class="font-display text-[clamp(44px,6vw,82px)] tracking-[0.05em]"
      >
        CÓMO TRABAJO
      </h2>

      <div class="mb-1 h-px flex-1 bg-[var(--rule)]"></div>

    </div>

    <!-- LIST -->
    <div class="flex flex-col">

      {
        about.philosophy.map((item) => (

          <article
            class="grid border-t border-[var(--rule)] py-12 lg:grid-cols-[120px_320px_1fr] lg:gap-16 lg:py-16"
          >

            <!-- NUMBER -->
            <div
              class="mb-6 font-display text-[56px] leading-none tracking-[-0.04em] text-[rgba(139,26,26,0.22)] lg:mb-0 lg:text-[82px]"
            >
              {item.number}
            </div>

            <!-- TITLE -->
            <div class="mb-6 lg:mb-0">

              <h3
                class="font-serif text-[clamp(28px,2vw,42px)] leading-[1.02] tracking-[-0.04em]"
              >
                {item.title}
              </h3>

            </div>

            <!-- TEXT -->
            <div>

              <p
                class="max-w-[760px] text-[15px] leading-[2] text-[var(--white-muted)] lg:text-[16px]"
              >
                {item.text}
              </p>

            </div>

          </article>

        ))
      }

      <!-- FINAL BORDER -->
      <div class="border-t border-[var(--rule)]"></div>

    </div>

  </div>

</section>

    <!-- SKILLS -->
    <section class="border-b border-[var(--rule)] py-24">
      <div class="mx-auto max-w-[1480px] px-8">
        <!-- HEADER -->
        <div class="mb-20 flex items-end gap-5">
          <span
            class="font-mono text-[9px] uppercase tracking-[0.22em] text-[rgba(139,26,26,0.65)]"
          >
            // 06
          </span>

          <h2
            class="font-display text-[clamp(44px,6vw,82px)] leading-none tracking-[0.04em]"
          >
            HERRAMIENTAS
          </h2>

          <div class="mb-2 h-px flex-1 bg-[var(--rule)]"></div>
        </div>

        <!-- GRID -->
        <div class="grid gap-x-20 gap-y-16 lg:grid-cols-2">
          <!-- DISEÑO -->
          <div>
            <div class="mb-7 flex items-center gap-5">
              <i
                class="fa-solid fa-pen-ruler text-[24px] text-[rgba(139,26,26,0.8)]"
              ></i>

              <h3 class="font-display text-[34px] uppercase tracking-[0.03em]">
                Diseño
              </h3>
            </div>

            <p
              class="max-w-[620px] font-serif text-[clamp(24px,2.2vw,42px)] leading-[1.2] tracking-[-0.04em] text-[var(--white-muted)]"
            >
              {about.skills.design.join(" · ")}
            </p>
          </div>

          <!-- DESARROLLO -->
          <div>
            <div class="mb-7 flex items-center gap-5">
              <i class="fa-solid fa-code text-[24px] text-[rgba(139,26,26,0.8)]"
              ></i>

              <h3 class="font-display text-[34px] uppercase tracking-[0.03em]">
                Desarrollo
              </h3>
            </div>

            <p
              class="max-w-[620px] font-serif text-[clamp(24px,2.2vw,42px)] leading-[1.2] tracking-[-0.04em] text-[var(--white-muted)]"
            >
              {about.skills.development.join(" · ")}
            </p>
          </div>

          <!-- CALIDAD -->
          <div>
            <div class="mb-7 flex items-center gap-5">
              <i
                class="fa-solid fa-gauge-high text-[24px] text-[rgba(139,26,26,0.8)]"
              ></i>

              <h3 class="font-display text-[34px] uppercase tracking-[0.03em]">
                Calidad
              </h3>
            </div>

            <p
              class="max-w-[620px] font-serif text-[clamp(24px,2.2vw,42px)] leading-[1.2] tracking-[-0.04em] text-[var(--white-muted)]"
            >
              {about.skills.quality.join(" · ")}
            </p>
          </div>

          <!-- PROCESO -->
          <div>
            <div class="mb-7 flex items-center gap-5">
              <i
                class="fa-solid fa-diagram-project text-[24px] text-[rgba(139,26,26,0.8)]"
              ></i>

              <h3 class="font-display text-[34px] uppercase tracking-[0.03em]">
                Proceso
              </h3>
            </div>

            <p
              class="max-w-[620px] font-serif text-[clamp(24px,2.2vw,42px)] leading-[1.2] tracking-[-0.04em] text-[var(--white-muted)]"
            >
              {about.skills.process.join(" · ")}
            </p>
          </div>
        </div>
      </div>
    </section>


<!-- CONTACT CTA -->
<section class="relative overflow-hidden border-b border-[var(--rule)] py-24">

  <div class="mx-auto max-w-[1480px] px-8">

    <!-- HEADER -->
    <div class="mb-14 flex items-end gap-5">

      <span
        class="font-mono text-[9px] uppercase tracking-[0.22em] text-[rgba(139,26,26,0.65)]"
      >
        // 07
      </span>

      <h2
        class="font-display text-[clamp(44px,6vw,82px)] leading-none tracking-[0.04em]"
      >
        CONTACTO
      </h2>

      <div class="mb-2 h-px flex-1 bg-[var(--rule)]"></div>

    </div>

    <!-- TOP -->
    <div
      class="mb-16 grid items-end gap-16 lg:grid-cols-[1fr_520px]"
    >

      <!-- LEFT -->
      <div>

        <h3
          class="max-w-[760px] font-serif text-[clamp(62px,8vw,132px)] leading-[0.86] tracking-[-0.05em]"
        >
          ¿Tienes un proyecto

          <span
            class="block italic text-[rgba(255,255,255,0.28)]"
          >
            que vale la pena
          </span>

          construir?
        </h3>

        <p
          class="mt-8 max-w-[520px] text-[15px] leading-[2] text-[var(--white-muted)]"
        >
          Estoy disponible para proyectos freelance,
          colaboraciones y conversaciones que vayan en serio.
        </p>

      </div>

      <!-- RIGHT -->
      <div
        class="grid border border-[var(--rule)] bg-[var(--bg2)]"
      >

        <!-- EMAIL -->
        <a
          href="mailto:jorgesoto.webdesigner@gmail.com"
          class="group relative overflow-hidden border-b border-[var(--rule)] p-10 transition-all duration-500 hover:bg-[rgba(139,26,26,0.04)]"
        >

          <div
            class="absolute bottom-[-18px] right-5 font-display text-[120px] leading-none text-[rgba(139,26,26,0.08)]"
          >
            01
          </div>

          <div
            class="mb-10 flex items-center justify-between"
          >

            <div
              class="flex h-14 w-14 items-center justify-center border border-[rgba(139,26,26,0.25)] text-[rgba(139,26,26,0.85)]"
            >
              <i class="fa-regular fa-envelope text-[18px]"></i>
            </div>

            <span
              class="font-mono text-[10px] uppercase tracking-[0.32em] text-[var(--white-dim)]"
            >
              Email Directo
            </span>

          </div>

          <div
            class="mb-8 h-px w-full bg-[var(--rule)]"
          ></div>

          <h4
            class="overflow-hidden text-ellipsis whitespace-nowrap font-serif text-[clamp(16px,1.25vw,28px)] leading-[2.00] tracking-[-0.03em] text-[var(--white)]"
          >
            jorgesoto.webdesigner@gmail.com
          </h4>

          <div
            class="mt-6 flex items-center gap-3 font-mono text-[10px] uppercase tracking-[0.28em] text-[rgba(139,26,26,0.85)]"
          >
            <span>Escribir ahora</span>

            <span
              class="transition-transform duration-300 group-hover:translate-x-1"
            >
              →
            </span>
          </div>

        </a>

        <!-- LINKEDIN -->
        <a
          href="https://www.linkedin.com/in/jorge-soto-tapia/"
          target="_blank"
          class="group relative overflow-hidden p-10 transition-all duration-500 hover:bg-[rgba(139,26,26,0.04)]"
        >

          <div
            class="absolute bottom-[-18px] right-5 font-display text-[120px] leading-none text-[rgba(139,26,26,0.08)]"
          >
            02
          </div>

          <div
            class="mb-10 flex items-center justify-between"
          >

            <div
              class="flex h-14 w-14 items-center justify-center border border-[rgba(139,26,26,0.25)] text-[rgba(139,26,26,0.85)]"
            >
              <i class="fa-brands fa-linkedin-in text-[18px]"></i>
            </div>

            <span
              class="font-mono text-[10px] uppercase tracking-[0.32em] text-[var(--white-dim)]"
            >
              LinkedIn
            </span>

          </div>

          <div
            class="mb-8 h-px w-full bg-[var(--rule)]"
          ></div>

          <h4
            class="overflow-hidden text-ellipsis whitespace-nowrap font-serif text-[clamp(22px,1.6vw,38px)] leading-[2.00] tracking-[-0.03em] text-[var(--white)]"
          >
            in/jorge-soto-tapia
          </h4>

          <div
            class="mt-6 flex items-center gap-3 font-mono text-[10px] uppercase tracking-[0.28em] text-[rgba(139,26,26,0.85)]"
          >
            <span>Ver perfil</span>

            <span
              class="transition-transform duration-300 group-hover:translate-x-1"
            >
              →
            </span>
          </div>

        </a>

      </div>

    </div>

    <!-- BOTTOM -->
    <div
      class="flex flex-col items-center justify-between gap-8 border-t border-[var(--rule)] pt-10 lg:flex-row"
    >

      <div
        class="flex items-center gap-8"
      >

        <span
          class="font-mono text-[10px] uppercase tracking-[0.3em] text-[var(--white-dim)]"
        >
          También en
        </span>

        <div
          class="flex items-center gap-8"
        >

          <a
            href="https://github.com/jorgesotowebdesigner"
            target="_blank"
            class="group flex items-center gap-3 text-[var(--white-muted)] transition-colors duration-300 hover:text-[var(--white)]"
          >
            <i class="fa-brands fa-github text-[15px]"></i>

            <span
              class="font-mono text-[11px] uppercase tracking-[0.22em]"
            >
              /jorgesotowebdesigner
            </span>
          </a>

          <a
            href="https://www.instagram.com/il_giorgio_/"
            target="_blank"
            class="group flex items-center gap-3 text-[var(--white-muted)] transition-colors duration-300 hover:text-[var(--white)]"
          >
            <i class="fa-brands fa-instagram text-[15px]"></i>

            <span
              class="font-mono text-[11px] uppercase tracking-[0.22em]"
            >
              /il_giorgio_
            </span>
          </a>

        </div>

      </div>

      <div
        class="font-mono text-[10px] uppercase tracking-[0.22em] text-[rgba(255,255,255,0.22)]"
      >
        Jorge Soto · Portafolio 2026 · Viña del Mar, CL
      </div>

    </div>

  </div>

</section>

  </main>
</MainLayout>
