---
import MainLayout from "../../layouts/MainLayout.astro";
import projects from "../../data/projects.json";
---

<MainLayout title="Proyectos">

  <!-- HERO -->
  <section class="border-b border-[var(--rule)] py-14">

    <div class="mx-auto max-w-[1420px] px-12">

      <div class="mb-16 flex items-start justify-between gap-20">

        <div>

          <span
            class="mb-6 block font-mono text-[11px] uppercase tracking-[0.32em] text-[rgba(139,26,26,0.8)]"
          >
            // 02 · PROYECTOS
          </span>

          <h1
            class="max-w-[980px] font-display text-[clamp(52px,5vw,96px)] uppercase leading-[0.88] tracking-[-0.05em]"
          >
            Casos de estudio & experiencias web
          </h1>

        </div>

        <p
          class="max-w-[320px] pt-3 text-[14px] leading-[2] text-[var(--white-muted)]"
        >
          Selección de proyectos enfocados en frontend, diseño UX/UI,
          ecommerce y experiencias digitales modernas utilizando Astro,
          React, Tailwind, Shopify y WordPress.
        </p>

      </div>

    </div>

  </section>

  <!-- PROJECTS -->
  <section>

    {
      projects.map((project) => (

        <article
          class="border-b border-[var(--rule)]"
        >

          <div
            class="mx-auto grid max-w-[1600px] lg:grid-cols-[0.78fr_1.22fr]"
          >

            <!-- LEFT -->
            <div class="flex flex-col justify-center px-14 py-16">

              <div>

                <div class="mb-10 flex items-center gap-5">

                  <span
                    class="font-mono text-[11px] uppercase tracking-[0.32em] text-[rgba(139,26,26,0.8)]"
                  >
                    {project.number}
                  </span>

                  <span
                    class="font-mono text-[11px] uppercase tracking-[0.32em] text-[var(--white-muted)]"
                  >
                    {project.year}
                  </span>

                </div>

                <h2
                  class="mb-8 max-w-[700px] font-serif text-[clamp(42px,3.8vw,74px)] leading-[0.95] tracking-[-0.04em]"
                >
                  {project.title}
                </h2>

                <p
                  class="mb-10 max-w-[620px] text-[16px] leading-[2] text-[var(--white-muted)]"
                >
                  {project.shortDescription}
                </p>

                <!-- STACK -->
                <div class="mb-10 flex flex-wrap items-center gap-3">

                  {
                    project.stack.map((item, index) => (

                      <>

                        <span
                          class="font-mono text-[10px] uppercase tracking-[0.22em] text-[var(--white-muted)]"
                        >
                          {item}
                        </span>

                        {
                          index < project.stack.length - 1 && (
                            <span class="text-[rgba(139,26,26,0.5)]">·</span>
                          )
                        }

                      </>

                    ))
                  }

                </div>

                <a
                  href={`/projects/${project.id}`}
                  class="editorial-button"
                >

                  Ver proyecto

                  <span>
                    ↗
                  </span>

                </a>

              </div>

            </div>

            <!-- RIGHT -->
            <div
              class="border-l border-[var(--rule)] bg-[var(--bg2)] p-10"
            >

              <img
                src={project.cover}
                alt={project.title}
                class="h-[620px] w-full object-cover object-top"
              />

            </div>

          </div>

        </article>

      ))
    }

  </section>

</MainLayout>